<?xml version="1.0" encoding="utf-8"?>
<!--
  保来屋片头动画 · 电影制片厂风格
  fullVersion=true  → 5.8s 完整版（光点→logo→打字机slogan→品牌名→域名→淡出）
  fullVersion=false → 3.5s 精简版（logo缩放→品牌名→淡出）
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/blw_splash_mask">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- logo 容器 -->
        <FrameLayout
            android:id="@+id/blw_splash_logo_box"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:visibility="invisible">

            <ImageView
                android:id="@+id/blw_splash_logo"
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:layout_gravity="center"
                android:adjustViewBounds="true"
                android:contentDescription="保来屋logo"
                android:scaleType="fitCenter"
                android:src="@drawable/blw_logo" />

            <!-- 时钟揭示层：叠在 logo 上，指针扫过处 logo 由 50% 透明变不透明 -->
            <com.github.tvbox.osc.util.BlwClockRevealLogo
                android:id="@+id/blw_splash_reveal"
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:layout_gravity="center" />

            <!-- 光点（完整版专用） -->
            <View
                android:id="@+id/blw_splash_glow"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_gravity="center"
                android:background="@drawable/blw_splash_glow_dot"
                android:visibility="gone" />
        </FrameLayout>

        <!-- slogan 打字机（完整版专用） -->
        <TextView
            android:id="@+id/blw_splash_slogan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text=""
            android:textColor="#7EDCC5"
            android:textSize="22sp"
            android:visibility="gone" />

        <!-- 品牌名 -->
        <TextView
            android:id="@+id/blw_splash_brand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:alpha="0"
            android:text="保来屋"
            android:textColor="#FFFFFF"
            android:textSize="34sp"
            android:textStyle="bold" />

        <!-- 域名（极淡） -->
        <TextView
            android:id="@+id/blw_splash_url"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:alpha="0"
            android:text="baolaiwu.cn"
            android:textColor="#009874"
            android:textSize="14sp" />
    </LinearLayout>

</FrameLayout>
