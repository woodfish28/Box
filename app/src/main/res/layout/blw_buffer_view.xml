<?xml version="1.0" encoding="utf-8"?>
<!--
  保来屋缓冲视图：圆形 logo + 半透明遮罩 + 时钟弧形进度
  BlwArcProgressView 自绘弧形进度条（12 点顺时针扫描）
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="vertical"
    android:tag="blw_buffer_view"
    android:visibility="gone">

    <com.github.tvbox.osc.util.BlwArcProgressView
        android:id="@+id/blw_buffer_arc"
        android:layout_width="160dp"
        android:layout_height="160dp">

        <ImageView
            android:id="@+id/blw_buffer_logo"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_gravity="center"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/blw_logo" />

    </com.github.tvbox.osc.util.BlwArcProgressView>

    <TextView
        android:id="@+id/blw_buffer_pct"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:shadowColor="#CC000000"
        android:shadowRadius="4"
        android:text="加载中"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold" />
</LinearLayout>
