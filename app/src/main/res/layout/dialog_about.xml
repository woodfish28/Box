<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:background="@drawable/shape_dialog_bg_main"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="@dimen/vs_30">

    <!-- 保来屋定制：品牌二维码区 -->
    <ImageView
        android:id="@+id/ivBrandLogo"
        android:layout_width="@dimen/vs_100"
        android:layout_height="@dimen/vs_100"
        android:layout_gravity="center"
        android:background="@android:color/white"
        android:contentDescription="保来屋 logo" />

    <TextView
        android:id="@+id/tvBrandTitle"
        android:layout_width="@dimen/vs_600"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vs_10"
        android:gravity="center"
        android:shadowColor="@color/color_000000_60"
        android:shadowRadius="3"
        android:textColor="@color/color_FFFFFF"
        android:textSize="@dimen/ts_24"
        android:textStyle="bold"
        tools:text="扫码关注 · 保来屋" />

    <TextView
        android:id="@+id/tvBrandSlogan"
        android:layout_width="@dimen/vs_600"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vs_10"
        android:gravity="center"
        android:shadowColor="@color/color_000000_60"
        android:shadowRadius="3"
        android:textColor="@color/color_FFFFFF"
        android:textSize="@dimen/ts_22"
        tools:text="保来屋 · 用专业为家撑伞" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vs_20"
        android:gravity="center"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivBrandQR"
                android:layout_width="@dimen/vs_150"
                android:layout_height="@dimen/vs_150"
                android:background="@android:color/white"
                android:contentDescription="微信二维码" />

            <TextView
                android:id="@+id/tvQrWechatLabel"
                android:layout_width="@dimen/vs_150"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vs_10"
                android:gravity="center"
                android:shadowColor="@color/color_000000_60"
                android:shadowRadius="3"
                android:textColor="@color/color_FFFFFF"
                android:textSize="@dimen/ts_18"
                tools:text="加微信 · 余仁哲" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/vs_20"
            android:layout_marginLeft="@dimen/vs_20"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivBrandQR2"
                android:layout_width="@dimen/vs_150"
                android:layout_height="@dimen/vs_150"
                android:background="@android:color/white"
                android:contentDescription="公众号二维码" />

            <TextView
                android:id="@+id/tvQrGzhLabel"
                android:layout_width="@dimen/vs_150"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vs_10"
                android:gravity="center"
                android:shadowColor="@color/color_000000_60"
                android:shadowRadius="3"
                android:textColor="@color/color_FFFFFF"
                android:textSize="@dimen/ts_18"
                tools:text="关注公众号 · 保来屋" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvBrandSubtitle"
        android:layout_width="@dimen/vs_600"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vs_12"
        android:gravity="center"
        android:lineSpacingMultiplier="1.4"
        android:shadowColor="@color/color_000000_60"
        android:shadowRadius="3"
        android:textColor="@color/color_FFFFFF"
        android:textSize="@dimen/ts_22"
        tools:text="保险医生余仁哲 · 您身边的保险管家" />

    <TextView
        android:id="@+id/tvBrandWebsite"
        android:layout_width="@dimen/vs_600"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vs_12"
        android:gravity="center"
        android:shadowColor="@color/color_000000_60"
        android:shadowRadius="3"
        android:textColor="@color/color_FFFFFF"
        android:textSize="@dimen/ts_22"
        tools:text="https://baolaiwu.cn" />

    <TextView
        android:id="@+id/tvBrandTip"
        android:layout_width="@dimen/vs_600"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vs_10"
        android:gravity="center"
        android:shadowColor="@color/color_000000_60"
        android:shadowRadius="3"
        android:textColor="@color/color_FFFFFF"
        android:textSize="@dimen/ts_20"
        tools:text="电视端订阅已内置，无需手动配置" />

    <!-- 原免责声明 -->
    <TextView
        android:layout_width="@dimen/vs_600"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vs_30"
        android:lineSpacingExtra="@dimen/ts_50"
        android:lineSpacingMultiplier="0"
        android:shadowColor="@color/color_000000_60"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="3"
        android:text="本软件只提供聚合展示功能，所有资源来自网上, 软件不参与任何制作, 上传, 储存, 下载等内容. 软件仅供学习参考, 请于安装后24小时内删除。\n\n打包分发请保留出处\nhttps://github.com/CatVodTVOfficial/TVBoxOSC"
        android:textColor="@color/color_FFFFFF"
        android:textSize="@dimen/ts_24" />
</LinearLayout>
